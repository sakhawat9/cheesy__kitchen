# Copy to .env.local and fill in. Next.js only loads dotfiles, so the file
# must be named .env.local — the project previously shipped it as "env.local"
# with no leading dot, which meant Next never loaded any of these and every
# value below was undefined at runtime (that is why JWT_SECRET, Cloudinary and
# the contact-form mailer all silently fell back or failed).

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# Leave unset to read and write the JSON files in /data — no database needed.
# Set to "mongodb" to use MONGODB_URI instead.
# DATA_SOURCE=mongodb
# MONGODB_URI=

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Signs session tokens. Use a long random string in production.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Contact form (optional — the form returns a clear 503 when unset)
# ---------------------------------------------------------------------------
USER_EMAIL=
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Image uploads (optional — /api/admin/upload returns 503 when unset)
# ---------------------------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Payments (optional — falls back to the shared Stripe test key)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_KEY=

# ---------------------------------------------------------------------------
# Seeding (only used by POST /api/seed when DATA_SOURCE=mongodb)
# ---------------------------------------------------------------------------
SEED_SECRET=
